{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "issueProvider": {
      "type": "object",
      "properties": {
        "tracker": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "labelMap": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "localDir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "codeHost": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "github"
        },
        "defaultBranch": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "branches": {
      "type": "object",
      "properties": {
        "feature": {
          "type": "string"
        },
        "bugfix": {
          "type": "string"
        },
        "hotfix": {
          "type": "string"
        },
        "refactor": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "worktrees": {
      "type": "object",
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "copyFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "prd": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "dimensionFloor": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maxRefinements": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        }
      },
      "additionalProperties": false
    },
    "rfc": {
      "type": "object",
      "properties": {
        "dir": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "babysit": {
      "type": "object",
      "properties": {
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "pollIntervalSec": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600
        },
        "timeoutMin": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      },
      "additionalProperties": false
    },
    "testing": {
      "type": "object",
      "properties": {
        "unit": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "integration": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "e2e": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "load": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
